{
  "$schema": "https://opencode.ai/config.json",
  "lsp": {},
  "instructions": [
    "OPENCODE.md",
    "AGENTS.md",
    ".agents/skills/backlog-groom/SKILL.md",
    ".agents/skills/backlog-review/SKILL.md"
  ],
  "mcp": {
    "gortex": {
      "command": [
        "/home/pat/.local/bin/gortex",
        "mcp",
        "--proxy"
      ],
      "enabled": true,
      "environment": {},
      "type": "local"
    },
    "jcodemunch": {
      "type": "local",
      "command": [
        "uvx",
        "jcodemunch-mcp"
      ],
      "enabled": true
    },
    "svelte": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@sveltejs/mcp"
      ],
      "enabled": true
    }
  }
}
