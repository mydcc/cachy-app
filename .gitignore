# Logs & Backups
logs/
backups/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-temporary-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional eslint cache
.eslintcache

# Cypress-cucumber-preprocessor cache directory
.tmp

# Optional REPL history
.node_repl_history

# Mac files
.DS_Store

# Svelte files
.svelte-kit/
build/

# Fuse-Box cache
.fusebox/

# Parcel cache
.parcel-cache

# Vitest cache
.vitest-cache
coverage/
dist/
.env
.env.*
# Must have no space after "!" — `! .env.example` is read as a literal filename,
# so the negation never applied and .env.example was silently ignored.
!.env.example
db/
test-results/
playwright-report/
blob-report/
.playwright/
reports/
target/
technicals-wasm/target/
__pycache__/
.claude/settings.local.json
.audit-results.json


build_old_*/
.last_build_time
.htaccess
.well-known/

# Generated backlog index. Committed only by sync-backlog.yml directly to
# develop/main after merge (see BUG-0225) — never as part of a feature PR.
# Local runs of `npm run backlog:index` still write it for a quick preview;
# this just stops it from being accidentally staged from a feature branch.
docs/backlog/INDEX.md

# Deployment configuration for one specific server. The template is tracked as
# .deploy.conf.example; the filled-in file is not — it names that server's paths,
# ports and start commands. deploy.sh regenerates it from the template if absent.
.deploy.conf

# Runtime artefacts of deploy.sh: the concurrency lock and the shadow build dir.
.deploy.lock
.deploy_work/
build_old_*/

# Per-agent git worktrees (AGENTS.md § Git Cleanliness) — never tracked.
# Accidentally committed in #2169, they broke actions/checkout on every PR
# merging develop (interpreted as submodules without a .gitmodules entry).
.worktrees/

# Temporary planning assets, third-party scratch data & ad-hoc verification (BUG-0192)
*_tpmp/
*_tmp/
verification/
info/
