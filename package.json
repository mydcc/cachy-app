{
  "name": "cachy-app",
  "version": "1.6.0-beta.462",
  "description": "Local-first position size and risk management calculator for crypto traders.",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mydcc/cachy-app.git"
  },
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build:wasm": "bash ./scripts/build_wasm.sh",
    "check:wasm": "node scripts/inspect_wasm.mjs",
    "dev": "npm run build:wasm && vite dev",
    "build": "npm run build:wasm && vite build",
    "postbuild": "node scripts/postbuild.mjs",
    "preview": "vite preview",
    "start": "node server.js",
    "check": "svelte-kit sync && bash ./scripts/run-lowpri.sh svelte-check --tsconfig ./tsconfig.json && npm run check:sw",
    "check:sw": "tsc -p src/service-worker/tsconfig.json --noEmit",
    "check:node": "node scripts/check-node-version.mjs",
    "check:engines-floor": "node scripts/check-engines-floor.mjs",
    "check:watch": "svelte-kit sync && bash ./scripts/run-lowpri.sh svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bash ./scripts/run-lowpri.sh vitest run",
    "test:watch": "bash ./scripts/run-lowpri.sh vitest",
    "test:unit": "bash ./scripts/run-lowpri.sh vitest run --project=unit",
    "test:changed": "bash ./scripts/run-lowpri.sh vitest run --changed",
    "test:seq": "bash ./scripts/run-lowpri.sh vitest run --no-file-parallelism",
    "test:e2e": "playwright test tests/e2e",
    "test:gpu": "playwright test --config playwright.gpu.config.ts",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "benchmark:technicals": "vitest bench",
    "backlog:index": "node scripts/backlog-index.mjs",
    "backlog:check": "node scripts/backlog-index.mjs --check",
    "backlog:check:stale": "node scripts/check-stale-in-progress.mjs",
    "backlog:promote": "node scripts/backlog-promote.mjs",
    "docs:links": "node scripts/check-doc-links.mjs",
    "i18n:types": "node scripts/generate-i18n-types.js",
    "arch": "npm run arch:validate && npm run arch:build",
    "arch:validate": "node $HOME/.config/opencode/skills/archify/bin/archify.mjs validate dataflow docs/architecture/cachy-architecture.dataflow.json --quality showcase",
    "arch:build": "node $HOME/.config/opencode/skills/archify/bin/archify.mjs deliver dataflow docs/architecture/cachy-architecture.dataflow.json docs/architecture/cachy-architecture.dataflow.html",
    "shadow:run": "node scripts/shadow-run.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/jsdom": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/ui": "^5.0.5",
    "@webgpu/types": "^0.1.74",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "opencode-omniroute-auth": "^1.2.2",
    "puppeteer": "^25.16.0",
    "semantic-release": "^25.0.9",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.9.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@google/generative-ai": "^0.24.1",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/dompurify": "^3.0.5",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "autoprefixer": "^10.6.2",
    "chart.js": "^4.6.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "compression": "^1.8.2",
    "crypto-js": "^4.2.0",
    "decimal.js": "^10.6.0",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "jsdom": "^30.1.3",
    "katex": "^0.18.10",
    "lightweight-charts": "^5.2.1",
    "lodash-es": "^4.18.1",
    "marked": "^18.1.2",
    "marked-katex-extension": "^5.1.13",
    "mime-types": "^3.0.2",
    "negotiator": "^1.1.0",
    "openai": "^7.45.0",
    "p-limit": "^7.3.3",
    "postcss": "^8.5.32",
    "rss-parser": "^3.13.0",
    "spacetimedb": "^2.13.0",
    "svelte": "^5.57.2",
    "svelte-i18n": "^4.0.1",
    "tailwindcss": "^4.3.2",
    "three": "^0.186.1",
    "undici": "^8.12.3",
    "vite": "^8.3.5",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "cookie": "1.1.1",
    "esbuild": "^0.28.2"
  }
}
