  "cards": [
    {
      "dot": "emerald",
      "title": "Primary Market Path",
      "items": [
        "Live ticks stream over WebSocket from Bitunix and Bitget into the aggregator",
        "technicalsService computes indicators in a WASM worker, off the main thread",
        "cmcService adds CoinMarketCap metadata; SMC and chart patterns share this pipeline",
        "Public Class C data never carries user identity"
      ]
    },
    {
      "dot": "rose",
      "title": "Local-First Boundary (ADR 0001)",
      "items": [
        "Class A data — journal, settings, API keys, presets — lives only in localStorage",
        "Calculator and trade-exec read journal and presets straight from localStorage (read paths not charted)",
        "Core code never imports SpacetimeDB or cloudService",
        "API keys leave the device only inside signed exchange requests"
      ]
    },
    {
      "dot": "orange",
      "title": "Support Services (not charted as flows)",
      "items": [
        "Backup and auto-backup services export the same local store on demand",
        "toast, tracking (consent-gated) and AI model services are orthogonal UI concerns",
        "Chat Cloud (SpacetimeDB) is opt-in, authenticated, non-essential — core never touches it"
      ]
    }
  ]
